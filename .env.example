# GitHub token with "Pull requests: read & write" (fine-grained) or "repo" scope (classic)
GITHUB_TOKEN=

# LLM provider: anthropic (ChatAnthropic), groq (default) or openai (both via ChatOpenAI).
LLM_PROVIDER=groq
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
# Optional model override (defaults: anthropic -> claude-opus-5-5, groq -> llama-3.3-70b-versatile,
# openai -> gpt-4o-mini)
LLM_MODEL=
# Anthropic only: effort level low|medium|high|xhigh|max (default high)
LLM_EFFORT=high

# Optional limits
MAX_FILES=15
MAX_SOURCE_LINES=400
RECURSION_LIMIT=80
