# GitHub token with "Pull requests: read & write" (fine-grained) or "repo" scope (classic)
GITHUB_TOKEN=

# LLM provider: groq (default) or openai. Both are called through langchain-openai's ChatOpenAI.
LLM_PROVIDER=anthropic
#GROQ_API_KEY=
#OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional model override (defaults: groq -> openai/gpt-oss-120b, openai -> gpt-4o-mini)
#LLM_MODEL=gpt-4o-mini

# Optional limits
MAX_FILES=15
MAX_SOURCE_LINES=400
RECURSION_LIMIT=80
